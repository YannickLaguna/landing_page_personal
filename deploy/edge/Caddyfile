# ============================================================================
# deploy/edge/Caddyfile — Tabla de dominios del VPS (ylaguna.com)
#
# Responsabilidad: HTTPS automático y reverse proxy por dominio.
# Relación con otros módulos:
#   - Montado por deploy/edge/docker-compose.yml.
#   - Cada destino es un alias en la red Docker `edge`:
#       landing:3000      → este repo (deploy/docker-compose.yml)
#       growsave-web:8000 → repo TFM (deploy/docker-compose.prod.yml)
#       umami:3000        → este repo (deploy/analitica/docker-compose.yml)
#   - DNS en Cloudflare: registros A de @, www, growsave y stats → IP del VPS.
#     Con proxy naranja, SSL/TLS en "Full (strict)".
# ============================================================================

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}
}

# Cabeceras de endurecimiento de la landing. GrowSave no las importa porque su app
# (app/services/security.py del repo TFM) ya envía las suyas y dos CSP se combinarían.
# CSP bloqueante desde 2026-11-23: se revisaron en el navegador la portada (es/en),
# GrowSave, info y una publicación con Plotly, KaTeX y Giscus; solo cargan recursos de
# ylaguna.com, stats.ylaguna.com y giscus.app, todos permitidos. Si una publicación nueva
# usa otro origen (p. ej. un iframe nuevo), añadirlo aquí antes de publicarla.
(cabeceras_landing) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://giscus.app https://stats.ylaguna.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://giscus.app; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://stats.ylaguna.com; frame-src https://giscus.app https://yannicklaguna.github.io https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

ylaguna.com {
	import comun
	import cabeceras_landing
	reverse_proxy landing:3000
}

www.ylaguna.com {
	redir https://ylaguna.com{uri} permanent
}

growsave.ylaguna.com {
	import comun
	reverse_proxy growsave-web:8000
}

# Umami (deploy/analitica/): panel + recogida de visitas sin cookies
stats.ylaguna.com {
	import comun
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy umami:3000
}

